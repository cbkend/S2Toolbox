<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="S2ToolboxWindow"
    Title="S2 Toolbox"
    Height="850"
    Width="1400"
    MinHeight="700"
    MinWidth="1200"
    WindowStartupLocation="CenterScreen"
    AutomationProperties.Name="S2 Toolbox Main Window"
    AutomationProperties.HelpText="Launch S2 Toolbox Add, Modify, and Delete scripts."
    KeyboardNavigation.TabNavigation="Continue">

    <Grid Margin="11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="180"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

       <GroupBox
            Grid.Row="0"
            Header="Connection Settings"
            Margin="0,0,0,8"
            AutomationProperties.Name="Connection Settings">
            <Grid Margin="10" KeyboardNavigation.TabNavigation="Local">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
					<ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label
                    Grid.Column="0"
                    Content="_Host:"
                    Target="{Binding ElementName=txtHost}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <TextBox
					x:Name="txtHost"
					Grid.Column="1"
					Height="28"
					IsEnabled="False"
					VerticalContentAlignment="Center"
					ToolTip="Coming Soon - Host override functionality is not yet available."
					AutomationProperties.Name="Host"
					AutomationProperties.HelpText="This feature is currently unavailable and will be enabled in a future release." />

                <Label
                    Grid.Column="3"
                    Content="_Username:"
                    Target="{Binding ElementName=txtUsername}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <TextBox
                    x:Name="txtUsername"
					Grid.Column="4"
                    Height="28"
                    IsEnabled="False"
					VerticalContentAlignment="Center"
                    TabIndex="1"
                    ToolTip="Coming Soon -S2 username. Leave empty to let the launched script prompt."
                    AutomationProperties.Name="Username"
                    AutomationProperties.HelpText="This feature is currently unavailable and will be enabled in a future release." />

                <Label
                    Grid.Column="6"
                    Content="_Password:"
                    Target="{Binding ElementName=txtPassword}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <PasswordBox
                    x:Name="txtPassword"
                    Grid.Column="7"
                    Height="28"
					IsEnabled="False"
                    TabIndex="2"
                    ToolTip="S2 password. It is transferred through a current-user protected temporary credential file, never on the process command line."
                    AutomationProperties.Name="Password"
                    AutomationProperties.HelpText="This feature is currently unavailable and will be enabled in a future release." />

                <Label
                    Grid.Column="9"
                    Content="P_rotocol:"
                    Target="{Binding ElementName=cmbProtocol}"
                    VerticalAlignment="Center"
                    Margin="0,0,5,0"/>
                <ComboBox
					x:Name="cmbProtocol"
					Grid.Column="10"
					Height="28"
					IsEnabled="False"
					SelectedIndex="1"
					Opacity="0.65"
					ToolTip="Coming Soon - Protocol selection is not yet available."
					AutomationProperties.Name="Protocol"
					AutomationProperties.HelpText="This feature is currently unavailable and will be enabled in a future release.">

					<ComboBoxItem Content="HTTP" />
					<ComboBoxItem Content="HTTPS (Default)" />
				</ComboBox>
				<TextBlock
					Grid.Column="11"
					VerticalAlignment="Center"
                    Margin="5,0,5,0"
					Foreground="DarkOrange"
					FontStyle="Italic"
					FontWeight="Bold"
					Text="Coming Soon" />
            </Grid>
        </GroupBox>

        <TextBox
            x:Name="txtSearch"
            Grid.Row="1"
            Height="32"
            Margin="0,0,0,8"
            FontSize="14"
            VerticalContentAlignment="Center"
            Text="Quick Search"
            Foreground="Gray"
            TabIndex="4"
            ToolTip="Filter the available toolbox scripts."
            AutomationProperties.Name="Quick Search"
            AutomationProperties.HelpText="Type part of a script name to filter the Add, Modify, and Delete launch buttons."/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox
                Header="ADD"
                Grid.Column="0"
                Margin="5"
                Foreground="Green"
                FontWeight="Bold"
                AutomationProperties.Name="Add Scripts">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel
                        x:Name="spAdd"
                        AutomationProperties.Name="Add Script Launchers"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox
                Header="MODIFY"
                Grid.Column="1"
                Margin="5"
                Foreground="DarkOrange"
                FontWeight="Bold"
                AutomationProperties.Name="Modify Scripts">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel
                        x:Name="spModify"
                        AutomationProperties.Name="Modify Script Launchers"/>
                </ScrollViewer>
            </GroupBox>

            <GroupBox
                Header="DELETE"
                Grid.Column="2"
                Margin="5"
                Foreground="Red"
                FontWeight="Bold"
                AutomationProperties.Name="Delete Scripts">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel
                        x:Name="spDelete"
                        AutomationProperties.Name="Delete Script Launchers"/>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <TextBox
            x:Name="txtLog"
            Grid.Row="3"
            Margin="0,8,0,8"
            VerticalScrollBarVisibility="Auto"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsReadOnly="True"
            IsTabStop="True"
            TabIndex="1000"
            FontFamily="Consolas"
            FontSize="12"
            ToolTip="S2 Toolbox activity log."
            AutomationProperties.Name="Activity Log"
            AutomationProperties.HelpText="Read-only activity and launch status messages."/>

        <StatusBar
            Grid.Row="4"
            AutomationProperties.Name="Application Status Bar">
            <TextBlock
                x:Name="txtStatus"
                Text="Ready"
                AutomationProperties.Name="Application Status"
                AutomationProperties.HelpText="Displays the current S2 Toolbox launcher status."/>
        </StatusBar>
    </Grid>
</Window>
